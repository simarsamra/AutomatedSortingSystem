END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRunMotor := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="running" Id="{7bbaea36-2752-4125-9591-ec8d8ed77f24}">
      <Declaration><![CDATA[
PROPERTY running : BOOL
]]></Declaration>
      <Get Name="Get" Id="{63f7e8ce-2270-4570-a58a-d3dd0e655874}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[running := isMotorRunning;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{d289d6aa-5919-4702-89ec-f8c66608b96e}">
        <Declaration><![CDATA[VAR
	bSimRun : BOOL := False;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[isMotorRunning := running;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="status" Id="{62b3d55e-d329-4e80-9fff-95eab784407d}">
      <Declaration><![CDATA[METHOD status : BOOL
