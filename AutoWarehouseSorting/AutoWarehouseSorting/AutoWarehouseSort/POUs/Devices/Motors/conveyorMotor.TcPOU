<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="conveyorMotor" Id="{921ba089-8039-4ce0-bc80-c9e7a1b5860e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK conveyorMotor IMPLEMENTS Imotor
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	bStartMotor : BOOL := FALSE;
	bStopMotor : BOOL := TRUE;
	bPauseMotor : BOOL := FALSE;
	eStates : eMotorStates := eMotorStates.firstrun;
	isMotorRunning : BOOL :=  FALSE;
	isError : BOOL := FALSE;
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE eStates OF
	eMotorStates.firstrun :
		IF bStartMotor THEN
			eStates := eMotorStates.starting;
		END_IF
	eMotorStates.starting:
		IF NOT bStopMotor THEN
			run();
			eStates := eMotorStates.running;
			isMotorRunning := TRUE;
		END_IF
	eMotorStates.running:
		IF bStopMotor THEN
			stop();
			isMotorRunning := FALSE;	
			eStates := eMotorStates.stopped;
		END_IF
		IF bPauseMotor THEN
			eStates := eMotorStates.pause;
		END_IF
	eMotorStates.stopped:
		IF bStartMotor AND NOT bStopMotor THEN
			eStates := eMotorStates.running;
		END_IF
	eMotorStates.pause:
		MpauseMotor();
		eStates := eMotorStates.paused;
	eMotorStates.paused:
		IF bStartMotor AND NOT bStopMotor THEN
			eStates := eMotorStates.running;
		END_IF
		IF  bStopMotor THEN
			eStates := eMotorStates.stopping;
		END_IF
END_CASE
]]></ST>
    </Implementation>
    <Property Name="error" Id="{efb640a5-e410-4653-b55f-d74c91aea802}">
      <Declaration><![CDATA[
PROPERTY error : BOOL
]]></Declaration>
      <Get Name="Get" Id="{d1906029-831f-4979-b1b9-2f57c10aea24}">
        <Declaration><![CDATA[VAR
	bError : BOOL;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[error := isError;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{63ce1efd-1b68-4c90-b17a-50f50b2435e5}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[isError := error;
]]></ST>
        </Implementation>
      </Set>
    </Property>
